# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración de WhatsApp
SESSION_NAME=wifi-session
BROWSER_NAME=ChatWiFi-Server
BROWSER_VERSION=1.0.0

# Seguridad y Logs (REEMPLAZAR CON VALORES SEGUROS)
LOG_LEVEL=info
SECRET_KEY=generate_a_secure_random_key_here
JWT_SECRET=generate_a_secure_jwt_secret_here
ENCRYPTION_KEY=generate_a_64_character_hex_key_here

# Google Drive Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# OR use credentials file (alternative to inline key):
# GOOGLE_CREDENTIALS_PATH=./google-credentials.json

# Google Drive Configuration
GOOGLE_DRIVE_ADMIN_EMAIL=your-admin@gmail.com
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=your_default_folder_id_here
GOOGLE_DRIVE_AUTO_GRANT=true
GOOGLE_DRIVE_ACCESS_EXPIRY_DAYS=0
GOOGLE_DRIVE_DEFAULT_ROLE=reader
# GOOGLE_DRIVE_REVOKE_INTERVAL_MS=3600000
